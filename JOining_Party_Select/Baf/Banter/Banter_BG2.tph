/////////////// Reset

// BG1
OUTER_SPRINT "RESPONSE_BANTER_BG1" ""
	// SoD
	OUTER_SPRINT "RESPONSE_BANTER_SoD" ""
		// BG2
		OUTER_SPRINT "RESPONSE_BANTER_BG2" ""
			// ToB
			OUTER_SPRINT "RESPONSE_BANTER_ToB" ""
/////////////////////////////////////////////////////

ACTION_IF (GAME_IS ~bg2ee eet~) AND (FILE_EXISTS_IN_GAME ~%BG2_BANTER%.dlg~) AND (NOT ~%BG2_BANTER%~ STRING_EQUAL_CASE ~~) BEGIN // BG2
		OUTER_SPRINT "RESPONSE_BANTER_BG2" ~~~~~	RESPONSE #3
//		SetGlobalTimer("JO_JOIN_BANTER_TIMER","LOCALS",FOUR_HOURS)
		DisplayString(Myself,~Try to banter.~)
		SetGlobal("JO_JOIN_BANTER_TIMER","GLOBAL",0)
		SetGlobal("JO_JOIN_BANTER_INTERACT","LOCALS",0)
		StartDialogOverride("%BG2_BANTER%",Myself) // [ALLY] [FAMILIAR] [PC] [ANYONE]
		Continue()~~~~~
END ELSE BEGIN
		OUTER_SPRINT "RESPONSE_BANTER_BG2" ""
END
ACTION_IF (GAME_IS ~bg2ee eet~) AND (FILE_EXISTS_IN_GAME ~%TOB_BANTER%.dlg~) AND (NOT ~%TOB_BANTER%~ STRING_EQUAL_CASE ~~) BEGIN // ToB
		OUTER_SPRINT "RESPONSE_BANTER_ToB" ~~~~~	RESPONSE #4
//		SetGlobalTimer("JO_JOIN_BANTER_TIMER","LOCALS",FOUR_HOURS)
		DisplayString(Myself,~Try to banter.~)
		SetGlobal("JO_JOIN_BANTER_TIMER","GLOBAL",0)
		SetGlobal("JO_JOIN_BANTER_INTERACT","LOCALS",0)
		StartDialogOverride("%TOB_BANTER%",Myself) // [ALLY] [FAMILIAR] [PC] [ANYONE]
		Continue()~~~~~
END ELSE BEGIN
		OUTER_SPRINT "RESPONSE_BANTER_ToB" ""
END

ACTION_IF (NOT ~%RESPONSE_BANTER_BG2%~ STRING_EQUAL_CASE ~~) OR (NOT ~%TOB_BANTER%~ STRING_EQUAL_CASE ~~) BEGIN

<<<<<<<< .../JOining_NPC.baf
IF
//
	!Global("JO_JOIN_AREA_TRANSITION","GLOBAL",1) 
	Global("JO_JOIN_LOADING_SWITCH","GLOBAL",0) // Not at loading
	Global("JO_JOIN_BANTER_BLOCK","GLOBAL",0)
//
	Global("JO_JOIN_SWITCHING_PARTY","GLOBAL",0)
	Global("JO_Myself_LeaveParty","LOCALS",0)
//
//	!GlobalTimerNotExpired("JO_JOIN_BANTER_TIMER","LOCALS")
//
	OR(3)
		Global("JO_JOIN_BANTER_TIMER","GLOBAL",1)
		Global("JO_JOIN_BANTER_INTERACT","LOCALS",1)
		HotKey(B)
//
	Global("JO_JOIN_IS_JOINING","LOCALS",0)
	Global("JO_JOIN_CUTSCENE","GLOBAL",0)
	Global("JO_JOIN","LOCALS",0)
	Global("JO_JOINI","LOCALS",0)
	Global("JO_NOJOIN","GLOBAL",0)
//
	ActionListEmpty()
	!ActuallyInCombat()
	!See([ENEMY])
	OR(2)
		Allegiance(Myself,FAMILIAR)
		!Global("JO_JOIN_IS_TRAVELER","LOCALS",0)
//
	Global("JO_JOIN_NEVER_BANTER","LOCALS",0)
	!Global("JO_Myself_Valid","LOCALS",0)
	Switch("JO_JOIN_CAMPAIGN_BANTER","GLOBAL")
//	OR(2)
//		RandomNum(4,2)
//		Global("JO_JOIN_BANTER_INTERACT","LOCALS",1)
	!AreaCheck("JO2608")
THEN
%RESPONSE_BANTER_BG2%
%RESPONSE_BANTER_ToB%
END

>>>>>>>>
EXTEND_BOTTOM ~%bcs%.bcs~ ~.../JOining_NPC.baf~ EVALUATE_BUFFER

