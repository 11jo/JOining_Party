END ELSE BEGIN
		OUTER_SPRINT "RESPONSE_DREAM_ToB" ""
END
ACTION_IF (NOT ~%RESPONSE_DREAM_BG1%~ STRING_EQUAL_CASE ~~) OR (NOT ~%RESPONSE_DREAM_SoD%~ STRING_EQUAL_CASE ~~) OR (NOT ~%RESPONSE_DREAM_BG2%~ STRING_EQUAL_CASE ~~) OR (NOT ~%RESPONSE_DREAM_ToB%~ STRING_EQUAL_CASE ~~) BEGIN

<<<<<<<< .../JOining_NPC.baf
IF
	PartyRested()
	Global("JO_JOIN_DREAM_DONE","LOCALS",1)
THEN	
	RESPONSE #100
		ChangeAIScript("",RACE)
		SetGlobal("JO_JOIN_DREAM_DONE","LOCALS",0)
//		SetGlobal("JO_JOIN_DREAM_REST","GLOBAL",0)
END

IF
//
	!Global("JO_JOIN_AREA_TRANSITION","GLOBAL",1) 
