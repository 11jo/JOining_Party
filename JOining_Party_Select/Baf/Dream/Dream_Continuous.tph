		DisplayString(Myself,~Try to dream talk.~)
		ChangeAIScript("%SoD_DREAM%",RACE)
		SetGlobal("JO_JOIN_DREAM_DONE","LOCALS",1)
		Continue()~~~~~
END ELSE BEGIN
		OUTER_SPRINT "RESPONSE_DREAM_SoD" ""
END
ACTION_IF (GAME_IS ~bg2ee eet~) AND (FILE_EXISTS_IN_GAME ~%BG2_DREAM%.bcs~) AND (NOT ~%BG2_DREAM%~ STRING_EQUAL_CASE ~~) BEGIN // BG2
		OUTER_SPRINT "RESPONSE_DREAM_BG2" ~~~~~	RESPONSE #3
