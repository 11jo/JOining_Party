		Continue()~~~~~
END ELSE BEGIN
		OUTER_SPRINT "RESPONSE_DREAM_BG2" ""
END
ACTION_IF (GAME_IS ~bg2ee eet~) AND (FILE_EXISTS_IN_GAME ~%TOB_DREAM%.bcs~) AND (NOT ~%TOB_DREAM%~ STRING_EQUAL_CASE ~~) BEGIN // ToB
		OUTER_SPRINT "RESPONSE_DREAM_ToB" ~~~~~	RESPONSE #4
