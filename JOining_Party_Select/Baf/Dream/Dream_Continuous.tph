ACTION_IF (GAME_IS ~bgee eet~) AND (FILE_EXISTS_IN_GAME ~%BG1_DREAM%.bcs~) AND (NOT ~%BG1_DREAM%~ STRING_EQUAL_CASE ~~) BEGIN // BG1
		OUTER_SPRINT "RESPONSE_DREAM_BG1" ~~~~~	RESPONSE #1
//		SetGlobal("JO_JOIN_DREAM_REST","GLOBAL",0)
		DisplayString(Myself,~Try to dream talk.~)
		ChangeAIScript("%BG1_DREAM%",RACE)
		SetGlobal("JO_JOIN_DREAM_DONE","LOCALS",1)
		Continue()~~~~~
END ELSE BEGIN
		OUTER_SPRINT "RESPONSE_DREAM_BG1" ""
END
ACTION_IF (GAME_INCLUDES ~SoD~) AND (FILE_EXISTS_IN_GAME ~%SoD_DREAM%.bcs~) AND (NOT ~%SoD_DREAM%~ STRING_EQUAL_CASE ~~) BEGIN // SoD
		OUTER_SPRINT "RESPONSE_DREAM_SoD" ~~~~~	RESPONSE #2
