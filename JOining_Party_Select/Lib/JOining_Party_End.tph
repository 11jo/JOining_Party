// SoD transition


// Avoid traveler to reintegrate party in Korlaz donjon
	ACTION_IF FILE_EXISTS_IN_GAME ~BDINTRO.bcs~ THEN BEGIN

		COPY_EXISTING ~BDINTRO.bcs~ ~override~
			DECOMPILE_AND_PATCH BEGIN
	// BDINTRO situation
			SPRINT textToReplace ~^[%TAB% ]*Global("SOD_fromimport","global",0)
^[%TAB% ]*InMyArea(\([^)]*\))~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF (num_matches > 0) BEGIN
				REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~\0
	TriggerOverride(\1,Global("JO_JOIN_IS_TRAVELER","LOCALS",0))~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
				PATCH_PRINT ~... //  InMyArea found in %SOURCE_FILESPEC%
				~
			END
		END
			BUT_ONLY


// Safana situation // Delete JoinPartyOverride
<<<<<<<<BDINTRO_SAFANA_rep.baf
IF
	Global("SOD_fromimport","global",1)
	Global("BD_Imoen_Items","GLOBAL",1)
	OR(2)
		Global("bd_party_has_lockpicking","BD0120",0)
		Global("bd_party_has_traps","BD0120",0)
	BeenInParty("safana")
THEN
	RESPONSE #100
		CutSceneId(Player1)
		MoveGlobal("BD0120","safana",[934.1718])
		ApplySpellRES("bdresurr","safana")
		SmallWait(1)
		ApplySpellRES("bdrejuve","safana")
		ActionOverride("safana",ChangeAIScript("bdsafana",OVERRIDE))
		ActionOverride("safana",SetDialog("bdsafana"))
		ActionOverride("safana",JoinPartyOverride())
END

IF
	Global("SOD_fromimport","global",1)
	Global("BD_Imoen_Items","GLOBAL",1)
	OR(2)
		Global("bd_party_has_lockpicking","BD0120",0)
		Global("bd_party_has_traps","BD0120",0)
	!BeenInParty("safana")
THEN
	RESPONSE #100
		CutSceneId(Player1)
		CreateCreature("safana7",[934.1718],NE)
		ActionOverride("safana",JoinPartyOverride())
END
>>>>>>>>

