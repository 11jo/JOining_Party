// JOining_Party_End.tph

// Compatiblity with transition mods

		INCLUDE ~JOining_Party_Select/Campaign_Transition/BG1_to_SoD_compat.tph~

//////////////////////////////////////////////////////////////////////////////////////

COPY_EXISTING_REGEXP GLOB ~.*\.are~ ~override~
//			PATCH_IF (~%SOURCE_RES%~ STR_CMP ~~) AND (NOT ~%SOURCE_RES%~ STR_EQ ~NONE~) BEGIN
//				WRITE_ASCIIE 0x94 ~%SOURCE_RES%~ #8
//						PATCH_PRINT ~%SOURCE_FILE% - Area script not assigned~
//			END
//			PATCH_IF (!FILE_EXISTS_IN_GAME ~%SOURCE_RES%.bcs~) BEGIN
//				PATCH_PRINT ~%SOURCE_RES% - Missing area script~
//					INNER_ACTION BEGIN
//				COPY ~JOining_Party_Select/Baf/blank.bcs~ ~override/%SOURCE_RES%.BCS~
//					END
//			END
			PATCH_IF (SOURCE_SIZE > 0x11b) AND (RESOURCE_CONTAINS ~mastarea.2da~ ~%SOURCE_RES%~) AND NOT (~%SOURCE_RES%~ STRING_EQUAL_CASE ~XG0319~) OR (SOURCE_SIZE > 0x11b) AND (RESOURCE_CONTAINS ~SODMAREA.2da~ ~%SOURCE_RES%~) AND NOT (~%SOURCE_RES%~ STRING_EQUAL_CASE ~XG0319~) BEGIN
				LPF fj_are_structure
					INT_VAR
					fj_variable_value = 1
					STR_VAR
					fj_structure_type = "variable"
					fj_name           = "JO_JOIN_AREA"
				END
			END
// INNER_ACTION BEGIN APPEND ~MASTAREA.2da~ ~%SOURCE_RES% value~ UNLESS ~%SOURCE_RES%~ END
				PATCH_PRINT ~... // %SOURCE_RES% is in mastarea.2da or sodmarea.2da
				Adding Global("JO_JOIN_AREA","MYAREA",1)
						~
//			PATCH_IF (SOURCE_SIZE > 0x11b) AND NOT (RESOURCE_CONTAINS ~mastarea.2da~ ~%SOURCE_RES%~) AND NOT (~%SOURCE_RES%~ STRING_EQUAL_CASE ~XG0319~) BEGIN
//					INNER_ACTION BEGIN
//				EXTEND_TOP ~%SOURCE_RES%.bcs~ ~JOining_Party_Select/Baf/SetMasterArea.baf~
//					END
//			END
			READ_LONG 0x14 flag
			PATCH_IF (SOURCE_SIZE > 0x11b) AND (flag BAND BIT0) AND NOT (~%SOURCE_RES%~ STRING_EQUAL_CASE ~XG0319~) BEGIN
				LPF fj_are_structure
					INT_VAR
					fj_variable_value = 1
					STR_VAR
					fj_structure_type = "variable"
					fj_name           = "JO_JOIN_NOSAVE"
				END
					PATCH_PRINT ~... // %SOURCE_RES% is a no save area
					Adding Global("JO_JOIN_NOSAVE","MYAREA",1)
						~
/*				PATCH_IF NOT (~%SOURCE_RES%.bcs~ STRING_EQUAL_CASE ~~) AND (FILE_EXISTS_IN_GAME ~%SOURCE_RES%.bcs~) BEGIN
					PATCH_PRINT ~... // %SOURCE_RES% have area script
						~
					INNER_ACTION BEGIN
						COPY_EXISTING_REGEXP ~%SOURCE_RES%.bcs~ ~override~
							DECOMPILE_AND_PATCH BEGIN
								SPRINT textToReplace ~RemoveAreaFlag(NOSAVE)~
								COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
									PATCH_IF (num_matches > 0) BEGIN
										REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~SetGlobal("JO_JOIN_SAVE_AREA","MYAREA",1)
									\0~
										PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
										PATCH_PRINT ~... // RemoveAreaFlag(NOSAVE) found in %SOURCE_FILESPEC%
										~
									END ELSE BEGIN
										PATCH_PRINT ~...%SOURCE_FILESPEC% don't have // RemoveAreaFlag(NOSAVE) ...No need patching.
										~
									END
								SPRINT textToReplace ~AddAreaFlag(NOSAVE)~
								COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
									PATCH_IF (num_matches > 0) BEGIN
										REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~SetGlobal("JO_JOIN_SAVE_AREA","MYAREA",0)
									\0~
										PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
										PATCH_PRINT ~... // AddAreaFlag(NOSAVE) found in %SOURCE_FILESPEC%
										~
									END ELSE BEGIN
										PATCH_PRINT ~...%SOURCE_FILESPEC% don't have // AddAreaFlag(NOSAVE) ...No need patching.
										~
									END
							END
					END
				END ELSE BEGIN
										PATCH_PRINT ~...%SOURCE_FILESPEC% don't have area script...No need patching.
										~
				END
			END ELSE PATCH_IF NOT (~%SOURCE_RES%.bcs~ STRING_EQUAL_CASE ~~) AND (FILE_EXISTS_IN_GAME ~%SOURCE_RES%.bcs~) BEGIN
						INNER_ACTION BEGIN
							COPY_EXISTING_REGEXP ~%SOURCE_RES%.bcs~ ~override~
								DECOMPILE_AND_PATCH BEGIN
									SPRINT textToReplace ~AddAreaFlag(NOSAVE)~
									COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
									PATCH_IF (num_matches > 0) BEGIN
										REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~SetGlobal("JO_JOIN_NOSAVE","MYAREA",1)
									\0~
										PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
										PATCH_PRINT ~... // AddAreaFlag(NOSAVE) found in %SOURCE_FILESPEC%
										~
									END
									SPRINT textToReplace ~RemoveAreaFlag(NOSAVE)~
									COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
									PATCH_IF (num_matches > 0) BEGIN
										REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~SetGlobal("JO_JOIN_NOSAVE","MYAREA",0)
									\0~
										PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
										PATCH_PRINT ~... // RemoveAreaFlag(NOSAVE) found in %SOURCE_FILESPEC%
										~
									END
								END
						END*/
			END
BUT_ONLY

// JO2608.are (Switching room)
COPY ~JOining_Party_Select/Are~ ~override~

	ACTION_IF !FILE_EXISTS_IN_GAME ~AM0604A.BAM~ THEN BEGIN
COPY ~JOining_Party_Select/Are/Bam/AM0604A.BAM~ ~override~
	END

APPEND ~MASTAREA.2da~ ~JO2608 value~ UNLESS ~JO2608~

	ACTION_IF FILE_EXISTS_IN_GAME ~SODMAREA.2da~ THEN BEGIN
APPEND ~SODMAREA.2da~ ~JO2608 value~ UNLESS ~JO2608~
	END

	COPY_EXISTING ~JO2608.are~ ~override~
		WRITE_ASCII 0x94 ~JO2608~ #8
		WRITE_LONG  0x14 (THIS BAND BNOT BIT0)
		WRITE_LONG  0x14 (THIS BAND BNOT BIT2)
		WRITE_LONG  0x14 (THIS BAND BNOT BIT5)
		WRITE_LONG  0x48 THIS | BIT7
		WRITE_SHORT  0x4e ~100~
		ADD_MAP_NOTE #1894 #1155 ~gray~ ~Travelers Items~


	COPY_EXISTING ~JO2608.wed~ ~override~
		WRITE_ASCII 0x24 ~JO2608~ (8)

