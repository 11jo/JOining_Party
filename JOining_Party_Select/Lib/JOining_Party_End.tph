// BD0120 is Korlaz Donjon
ACTION_IF (GAME_IS ~eet~ OR GAME_INCLUDES ~SoD~) BEGIN

INCLUDE ~JOining_Party_Select/Campaign_Transition/BD0120.tph~

COPY_EXISTING ~%Undercity_TempleofBhaal%.bcs~ ~override~
		DECOMPILE_AND_PATCH BEGIN
			SPRINT textToReplace ~^[%TAB% ]*SaveGame(\([^)]*\)~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF (num_matches > 0) BEGIN
				REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~SetGlobal("JO_JOIN_AREA_TRANSITION","GLOBAL",1)
				SetGlobal("JO_JOIN_BG1_TRANSITION","%Undercity_TempleofBhaal%",1)
	\0~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
				PATCH_PRINT ~... // Undercity_TempleofBhaal : SaveGame found in %SOURCE_FILESPEC% for JO_JOIN_AREA_TRANSITION
				~
			END
		END

EXTEND_TOP ~BDROPE.bcs~ ~JOining_Party_Select/Campaign_Transition/BD0120_BDROPE.BAF~ EVALUATE_BUFFER

// MoveToCampaign("SoD") script
COPY_EXISTING ~BDSODTRN.bcs~ ~override~
		DECOMPILE_AND_PATCH BEGIN
			SPRINT textToReplace ~^[%TAB% ]*CutSceneId(Player1)~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF (num_matches > 0) BEGIN
				REPLACE_TEXTUALLY CASE_INSENSITIVE ~%textToReplace%~ ~\0
		StartCutSceneMode()
		SetGlobal("JO_JOIN_AREA_TRANSITION","GLOBAL",1)~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SOURCE_FILESPEC% for REPLACE_TEXTUALLY: %textToReplace%~
				PATCH_PRINT ~... // BDSODTRN : EndOfBG1 found in %SOURCE_FILESPEC% for JO_JOIN_AREA_TRANSITION
				~
			END
		END

END

	ACTION_IF FILE_EXISTS_IN_GAME ~%NBaldursGate_DucalPalace_L1%.bcs~ THEN BEGIN

<<<<<<<< .../JOining_DucalPalace.baf

IF
	Dead("Sarevok")
	Global("EndOfBG1","GLOBAL",0)
	!Global("JO_JOIN_AREA_TRANSITION","GLOBAL",1)
	Global("JO_JOIN_DucalPalace_TRANSITION","MYAREA",0)
THEN
	RESPONSE #100
		SetGlobal("JO_JOIN_AREA_TRANSITION","GLOBAL",1)
		SetGlobal("JO_JOIN_DucalPalace_TRANSITION","MYAREA",1)
		Continue()
END

