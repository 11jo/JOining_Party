	%slashzero%~
				PATCH_PRINT ~Patching: %num_matches% matches found in %SF_workaround% for REPLACE_TEXTUALLY: %textToReplace%~
				PATCH_PRINT ~... // ActionOverride() StartDialog(%Death_var%) found in %SF_workaround%
				~
			END
			SPRINT textToReplace ~^[%%TAB%% ]*ActionOverride(\([^)]*\),StartDialog\([^)]*\)NoSet\([^)]*\)("%Death_var%"))~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
