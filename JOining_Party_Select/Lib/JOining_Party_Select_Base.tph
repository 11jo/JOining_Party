//////// Activate ///////////
			REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~Replace_Death_in_StartDialog_1~ ~~~~~Replace_Death_in_StartDialog_1

			SPRINT textToReplace ~^[%%TAB%% ]*ActionOverride("%Death_var%",StartDialog\(ue\)?("\([^)]*\)",\([^)]*\)))~
			COUNT_REGEXP_INSTANCES ~%textToReplace%~ num_matches
			PATCH_IF (num_matches > 0) BEGIN
