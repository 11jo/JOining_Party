BACKUP ~weidu_external/JOining_Party_Select/backup~
AUTHOR ~~

VERSION ~Beta.1.5~

AUTO_EVAL_STRINGS

ASK_EVERY_COMPONENT

ALWAYS
/*
	DEFINE_ACTION_FUNCTION autotra_workaround BEGIN
	COPY ~JOining_Party_Select/Languages/french~				~weidu_external/JOining_Party_Select/Languages/autotra/%LANGUAGE%~
	COPY ~JOining_Party_Select/Languages/%LANGUAGE%~				~weidu_external/JOining_Party_Select/Languages/autotra/%LANGUAGE%~
	END

	LAF autotra_workaround END
*/
END // ALWAYS

// AUTO_TRA ~weidu_external/JOining_Party_Select/Languages/autotra/%LANGUAGE%~


LANGUAGE ~English~
         ~english~
         ~JOining_Party_Select/Languages/english/setup.tra~


// Special componant only use for adding new NPC to the mod.
// Will expend mod files with data added to Next_Traveler_cpmvars.tpa
BEGIN ~Next Traveler~
DESIGNATED 3
LABEL ~JOining_Party-Next_Traveler~
NO_LOG_RECORD
INCLUDE ~JOining_Party_Select/Traveler/Next_Traveler_cpmvars.tpa~
INCLUDE ~JOining_Party_Select/Traveler/Next_Traveler.tpa~

