// Expand JO2608.baf
	// Regular : At BG or SoD end, Travelers go to the switching room and can be recruted again.
		// SoD_Content : At BG end, Travelers with SoD content are destroyself once in the switching room.
			// BG2_Content : At SoD end, Travelers with BG2 content are destroyself once in the switching room.


// Regular

<<<<<<<< .../JOining_JO2608.baf

IF
	Global("JO2608_Create","MYAREA",0)
	!TriggerOverride("%Death_var%",Global("JO_JOIN_END_OF_WATCH","LOCALS",0))
	!InMyArea("%Death_var%")
THEN
	RESPONSE #100
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_END_OF_WATCH","LOCALS",0))
		SetGlobal("JO2608_Create","MYAREA",1)
		MoveGlobal("JO2608","%Death_var%",[801.499])
		Wait(1)
		ActionOverride("JO_JOIN_Room_Container",TakeCreatureItems("%Death_var%",BACKPACK))
		Wait(3)
		ActionOverride("%Death_var%",RandomWalk())
		SetGlobal("JO2608_Create","MYAREA",0)
END

>>>>>>>>
EXTEND_BOTTOM ~JO2608.bcs~ ~.../JOining_JO2608.baf~ EVALUATE_BUFFER

// SoD_Content

	ACTION_IF ~%Death_var%_SoD_Content~ = 1 THEN BEGIN


<<<<<<<< .../JOining_SoD_JO2608.baf

IF
	!TriggerOverride("%Death_var%",Global("JO_JOIN_END_OF_BG1","LOCALS",0))
	InMyArea("%Death_var%")
THEN
	RESPONSE #100
		DisplayString("%Death_var%",~%%Death_var%_name% has heard about the crusade.~)
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_END_OF_BG1","LOCALS",0))
		Wait(4)
		ActionOverride("%Death_var%",DestroySelf())
END

>>>>>>>>
EXTEND_BOTTOM ~JO2608.bcs~ ~.../JOining_SoD_JO2608.baf~ EVALUATE_BUFFER


	END 


// BG2_Content

		ACTION_IF ~%Death_var%_BG2_Content~ = 1 THEN BEGIN


<<<<<<<< .../JOining_BG2_JO2608.baf

IF
	!TriggerOverride("%Death_var%",Global("JO_JOIN_END_OF_SOD","LOCALS",0))
	InMyArea("%Death_var%")
THEN
	RESPONSE #100
		DisplayString("%Death_var%",~%%Death_var%_name% has heard about the city of coins.~)
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_END_OF_SOD","LOCALS",0))
		Wait(4)
		ActionOverride("%Death_var%",DestroySelf())
END

>>>>>>>>
EXTEND_BOTTOM ~JO2608.bcs~ ~.../JOining_BG2_JO2608.baf~ EVALUATE_BUFFER


		END


///////////////////////////////////////////////////////////////////////////////

// END_OF_WATCH

