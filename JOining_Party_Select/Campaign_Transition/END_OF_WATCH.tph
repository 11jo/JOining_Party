<<<<<<<< .../JOining_stay_JO2608AL.baf

IF
	InMyArea([PC])
	AreaCheck("JO2608")
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	TriggerOverride("%Death_var%",Global("JO_JOIN_NOHOLD_JO2608","LOCALS",1))
	TriggerOverride(Player1,Global("JO2608_Create","LOCALS",0))
THEN
	RESPONSE #100
		ActionOverride("JO2608AL",ForceSpell("%Death_var%",NOHOLD_PARTY))
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_NOHOLD_JO2608","LOCALS",0)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
END

IF
	InMyArea([PC])
	AreaCheck("JO2608")
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	TriggerOverride("%Death_var%",Global("JO_Myself_AllowDead","LOCALS",0))
	!TriggerOverride("%Death_var%",Global("JO_JOIN_NOHOLD_JO2608","LOCALS",1))
	Global("JO_JOIN_GATHER_JO2608","MYAREA",1)
	TriggerOverride("%Death_var%",Global("JO_JOIN_SEE_JO2608","LOCALS",0))
THEN
	RESPONSE #100
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_SEE_JO2608","LOCALS",1)
		ActionOverride("%Death_var%",MoveToObjectNoInterrupt("JO2608AL"))
		Continue()
END

IF
	InMyArea([PC])
	AreaCheck("JO2608")
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	TriggerOverride("%Death_var%",Global("JO_JOIN_SEE_JO2608","LOCALS",2))
	TriggerOverride("%Death_var%",See("JO2608AL"))
THEN
	RESPONSE #100
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_SEE_JO2608","LOCALS",3)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
END

IF
	InMyArea([PC])
	AreaCheck("JO2608")
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	TriggerOverride("%Death_var%",Global("JO_JOIN_SEE_JO2608","LOCALS",3))
	OR(2)
		!TriggerOverride("%Death_var%",See("JO2608AL"))
		Global("JO_JOIN_GATHER_JO2608","MYAREA",0)
THEN
	RESPONSE #100
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_SEE_JO2608","LOCALS",0)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
END

