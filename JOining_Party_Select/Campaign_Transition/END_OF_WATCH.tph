// Note :
		// Expand All_in.baf for BG1/SoD npc
			// After Leave Party above
				// Special BG1/SoD end
					// Related to JO_JOIN_CAMPAIGN_TRANSITION in JO_JOINI.baf
///////////////////////////////////////////////////////////////////////////////

//		ACTION_IF ~BG1_%Death_var%_Select~ = 1 OR ~SoD_%Death_var%_Select~ = 1 OR ~Continuous_%Death_var%_Select~ = 1 THEN BEGIN

COPY ~weidu_external/JOining_Party_Select/All_In/%Death_var%_All_In.baf~  ~weidu_external/JOining_Party_Select/All_In/%Death_var%_All_In.baf~ EVALUATE_BUFFER

// For All_in.baf
	REPLACE_TEXTUALLY ~// REPLACE_END_OF_WATCH~ ~~~~~

IF
	AreaCheck("BD0120")
//
	Global("JO_JOIN_CUTSCENE","GLOBAL",0)
	Global("JO_JOIN_LOADING_SWITCH","GLOBAL",0) // Loading switch inactive
	Global("JO_JOIN_CUTSCENE","GLOBAL",0) // No cuscene
	Global("JO_NOJOIN","GLOBAL",0) // No join stop
	Global("JO_JOIN_RETURN_SLOT","GLOBAL",0) // Not implemented
//
//	Global("JO_Myself_LeaveParty","LOCALS",0)
	Global("JO_JOIN_END_OF_WATCH","LOCALS",1)
	Switch("JO_JOIN_TALK_TRANSITION","LOCALS") // Only one traveler say something (Set in JO_JOINI.baf)
THEN
	RESPONSE #0
		SetInterrupt(FALSE)
		MakeGlobalOverride()
		SetGlobal("K#PartySoD","LOCALS",1)
		SetGlobal("JO_JOIN_END_OF_WATCH","LOCALS",2)
		SetGlobal("JO_JOIN_END_OF_BG1","LOCALS",1)
		CreateVisualEffectObject("JOBG402",Myself)
		SetInterrupt(TRUE)
		DestroySelf()
	RESPONSE #1
		SetInterrupt(FALSE)
		DisplayStringHead(Myself,~We will meet again.~)
		MakeGlobalOverride()
		SetGlobal("K#PartySoD","LOCALS",1)
		SetGlobal("JO_JOIN_END_OF_WATCH","LOCALS",2)
		SetGlobal("JO_JOIN_END_OF_BG1","LOCALS",1)
		CreateVisualEffectObject("JOBG402",Myself)
		SetInterrupt(TRUE)
		DestroySelf()
END

IF
	AreaCheck("BD6000")
//
	Global("JO_JOIN_CUTSCENE","GLOBAL",0)
	Global("JO_JOIN_LOADING_SWITCH","GLOBAL",0) // Loading switch inactive
	Global("JO_JOIN_CUTSCENE","GLOBAL",0) // No cuscene
	Global("JO_NOJOIN","GLOBAL",0) // No join stop
	Global("JO_JOIN_RETURN_SLOT","GLOBAL",0) // Not implemented
//
//	Global("JO_Myself_LeaveParty","LOCALS",0)
	Global("JO_JOIN_END_OF_WATCH","LOCALS",1)
	Switch("JO_JOIN_TALK_TRANSITION","LOCALS") // Only one traveler say something (Set in JO_JOINI.baf)
THEN
	RESPONSE #0
		SetInterrupt(FALSE)
		MakeGlobalOverride()
		SetGlobal("K#PartySoD","LOCALS",1)
		SetGlobal("JO_JOIN_END_OF_WATCH","LOCALS",2)
		SetGlobal("JO_JOIN_END_OF_SOD","LOCALS",1)
		CreateVisualEffectObject("JOBG402",Myself)
		SetInterrupt(TRUE)
		DestroySelf()
	RESPONSE #1
		SetInterrupt(FALSE)
		MakeGlobalOverride()
		DisplayStringHead(Myself,~Gonna make a diversion, the Flamming Fist will search for you everywhere...~)
		SetGlobal("K#PartySoD","LOCALS",1)
		SetGlobal("JO_JOIN_END_OF_WATCH","LOCALS",2)
		SetGlobal("JO_JOIN_END_OF_SOD","LOCALS",1)
		CreateVisualEffectObject("JOBG402",Myself)
		SetInterrupt(TRUE)
		DestroySelf()
END


	%c#ebg122_END_OF_WATCH%

~~~~~

//		END

// For JO2608AL.baf
	// Avatar of Alaundo
<<<<<<<< .../JOining_stay_JO2608AL.baf

IF
	See(Player1)
	AreaCheck("JO2608")
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	TriggerOverride(Player1,Global("JO_JOIN_JUMP_JO2608","LOCALS",0))
	!TriggerOverride("%Death_var%",Global("JO_JOIN_HOLD_WATCH","LOCALS",0))
	Global("JO2608_Create","MYAREA",0)
THEN
	RESPONSE #100
		ReallyForceSpell("%Death_var%",NOHOLD_PARTY)
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_HOLD_WATCH","LOCALS",0))
		Continue()
END

IF
	Global("JO_Myself_AllowDead","LOCALS",0)
	InMyArea([PC])
	AreaCheck("JO2608")
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	Global("JO_JOIN_GATHER_JO2608","MYAREA",1)
	TriggerOverride("%Death_var%",Global("JO_JOIN_SEE_JO2608AL","LOCALS",0))
THEN
	RESPONSE #100
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_SEE_JO2608AL","LOCALS",1)
		ActionOverride("%Death_var%",MoveToObjectNoInterrupt("JO2608AL"))
		Continue()
END

IF
	Global("JO_Myself_AllowDead","LOCALS",0)
	InMyArea([PC])
	AreaCheck("JO2608")
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	TriggerOverride("%Death_var%",Global("JO_JOIN_SEE_JO2608AL","LOCALS",2))
	TriggerOverride("%Death_var%",See("JO2608AL"))
THEN
	RESPONSE #100
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_SEE_JO2608AL","LOCALS",3)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
END

IF
	Global("JO_Myself_AllowDead","LOCALS",0)
	InMyArea([PC])
	AreaCheck("JO2608")
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	TriggerOverride("%Death_var%",Global("JO_JOIN_SEE_JO2608AL","LOCALS",3))
	OR(2)
		!TriggerOverride("%Death_var%",See("JO2608AL"))
		Global("JO_JOIN_GATHER_JO2608","MYAREA",0)
THEN
	RESPONSE #100
		ActionOverride("%Death_var%",SetGlobal("JO_JOIN_SEE_JO2608AL","LOCALS",0)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
END

>>>>>>>>
EXTEND_BOTTOM ~JO2608AL.bcs~ ~.../JOining_stay_JO2608AL.baf~ EVALUATE_BUFFER


// For JO2608.baf
<<<<<<<< .../JOining_stay_JO2608.baf

IF
	Global("JO_Myself_AllowDead","LOCALS",0)
	InMyArea([PC])
	Global("JO_JOIN_LOADING_SWITCH","GLOBAL",0)
	InMyArea("%Death_var%")
	!Dead("%Death_var%")
	Global("JO2608_Create","MYAREA",0)
	RandomNum(30,5)
	!GlobalTimerNotExpired("JO_JOIN_STAY_JO2608","LOCALS")
THEN
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		ActionOverride("%Death_var%",VerbalConstant(Myself,TIRED))
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		DisplayStringHead("%Death_var%",~Don't expect me to do the dishes.~)
		ActionOverride("%Death_var%",MoveToPointNoInterrupt([253.823]))
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		ActionOverride("%Death_var%",MoveToObjectNoInterrupt([PC]))
		ActionOverride("%Death_var%",ApplySpell([PC],RESTORE_FULL_HEALTH))
		Wait(3)
		DisplayStringHead("%Death_var%",~Here you go.~)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		ActionOverride("%Death_var%",RandomTurn())
		DisplayStringHead("%Death_var%",~What about now ?~)
		Wait(2)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		ActionOverride("%Death_var%",VerbalConstant(Myself,INITIAL_MEETING))
		Wait(2)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		ActionOverride("%Death_var%",MoveToObjectNoInterrupt([PC]))
		ActionOverride("%Death_var%",ApplySpell([PC],CLERIC_NEUTRALIZE_POISON))
		Wait(3)
		DisplayStringHead("%Death_var%",~Here you go.~)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		DisplayStringHead("%Death_var%",~Ha ha... Ha ha ha...~)
		Wait(4)
		DisplayStringHead("%Death_var%",~HAHAHAHAAAAAAAAH !~)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		DisplayStringHead("%Death_var%",~Good on you if you save the day. I care not, for I am gone !~)
		ActionOverride("%Death_var%",MoveToPointNoInterrupt([1860.1346]))
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		ActionOverride("%Death_var%",VerbalConstant(Myself,HAPPY))
		Wait(2)
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		DisplayStringHead("%Death_var%",~I have nothing else to do...~)
		ActionOverride("%Death_var%",MoveToPointNoInterrupt([1655.666]))
		ActionOverride("%Death_var%",RandomWalk())
		Continue()
	RESPONSE #2
		SetGlobalTimer("JO_JOIN_STAY_JO2608","LOCALS",FOUR_TURNS)
		ActionOverride("%Death_var%",MoveToObjectNoInterrupt([PC]))
		ActionOverride("%Death_var%",ApplySpell([PC],CLERIC_RESTORATION))
