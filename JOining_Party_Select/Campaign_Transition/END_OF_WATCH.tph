// Expand JO_joiW.baf
	// Regular : At BG or SoD end, Travelers go to the switching room and can be recruted again.
		// SoD_Content : At BG end, Travelers with SoD content are destroyself once in the switching room.
			// BG2_Content : At SoD end, Travelers with BG2 content are destroyself once in the switching room.

// For JO_JOINW.baf

// Regular
ACTION_IF (~%Death_var%_SoD_Content~ = 0 ) AND (~%Death_var%_BG2_Content~ = 0 OR NOT GAME_IS ~eet~) THEN BEGIN

		OUTER_SET x_coo = RANDOM(861 1122)
		OUTER_SET y_coo = RANDOM(287 467)

	<<<<<<<< .../JOining_JO2608.baf

	IF
		AreaCheck("JO2608")
		!TriggerOverride("%Death_var%",Global("JO_JOIN_END_OF_WATCH","LOCALS",0))
		!InMyArea("%Death_var%")
	THEN
		RESPONSE #100
			ActionOverride("%Death_var%",SetGlobal("JO_JOIN_END_OF_WATCH","LOCALS",0))
			SetGlobal("JO2608_Create","MYAREA",1)
			MoveGlobal("JO2608","%Death_var%",[%x_coo%.%y_coo%])
			ActionOverride("%Death_var%",SetGlobal("JO_JOIN_HOLD_WATCH","LOCALS",1))
			ReallyForceSpell("%Death_var%",HOLD_PARTY)
			ActionOverride("JO_JOIN_BG1_Container",TakeCreatureItems("%Death_var%",BACKPACK))
			ActionOverride("%Death_var%",RandomWalk())
			Continue()
	END

	>>>>>>>>
	EXTEND_TOP ~JO_JOINW.bcs~ ~.../JOining_JO2608.baf~ EVALUATE_BUFFER

END

// SoD_Content only
ACTION_IF (~%Death_var%_SoD_Content~ = 1) AND (NOT ~%Death_var%_BG2_Content~ = 1 OR NOT GAME_IS ~eet~) THEN BEGIN

		OUTER_SET x_coo = RANDOM(1921 2145)
		OUTER_SET y_coo = RANDOM(1088 1092)


	<<<<<<<< .../JOining_SoD_JO2608.baf

	IF
		AreaCheck("JO2608")
		!TriggerOverride("%Death_var%",Global("JO_JOIN_END_OF_WATCH","LOCALS",0))
		!InMyArea("%Death_var%")
	THEN
		RESPONSE #100
			ActionOverride("%Death_var%",SetGlobal("JO_JOIN_END_OF_WATCH","LOCALS",0))
			SetGlobal("JO2608_Create","MYAREA",1)
			MoveGlobal("JO2608","%Death_var%",[%x_coo%.%y_coo%])
			ActionOverride("%Death_var%",SetGlobal("JO_JOIN_HOLD_WATCH","LOCALS",1))
			ReallyForceSpell("%Death_var%",HOLD_PARTY)
			ActionOverride("JO_JOIN_SoD_Container",TakeCreatureItems("%Death_var%",BACKPACK))
			ActionOverride("%Death_var%",RandomWalk())
			Continue()
	END

	IF
		AreaCheck("JO2608")
		!TriggerOverride("%Death_var%",Global("JO_JOIN_END_OF_BG1","LOCALS",0))
		InMyArea("%Death_var%")
	THEN
		RESPONSE #100
			DisplayStringHead(Player1,~%%Death_var%_name% has heard about the crusade.~)
			SmallWait(2)
			ReallyForceSpell("%Death_var%",NOHOLD_PARTY)
			ActionOverride("%Death_var%",SetGlobal("JO_JOIN_HOLD_WATCH","LOCALS",0))
			ActionOverride("%Death_var%",SetGlobal("JO_JOIN_END_OF_BG1","LOCALS",0))
			ActionOverride("%Death_var%",DestroySelf())
	END

	>>>>>>>>
	EXTEND_TOP ~JO_JOINW.bcs~ ~.../JOining_SoD_JO2608.baf~ EVALUATE_BUFFER


END


// BG2_Content only
ACTION_IF (~%Death_var%_BG2_Content~ = 1 AND NOT ~%Death_var%_SoD_Content~ = 1) AND (GAME_IS ~eet~) THEN BEGIN

		OUTER_SET x_coo = RANDOM(1314 1509)
		OUTER_SET y_coo = RANDOM(1518 1522)


	<<<<<<<< .../JOining_BG2_JO2608.baf

