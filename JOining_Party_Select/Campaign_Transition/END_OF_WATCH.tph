		!TriggerOverride("%Death_var%",Global("JO_JOIN_END_OF_SOD","LOCALS",0))
		InMyArea("%Death_var%")
	THEN
		RESPONSE #100
			DisplayStringHead(Player1,~%%Death_var%_name% has heard about the city of coins.~)
			SmallWait(2)
			ReallyForceSpell("%Death_var%",NOHOLD_PARTY)
			ActionOverride("%Death_var%",SetGlobal("JO_JOIN_HOLD_WATCH","LOCALS",0))
			ActionOverride("%Death_var%",SetGlobal("JO_JOIN_END_OF_SOD","LOCALS",0))
			ActionOverride("%Death_var%",DestroySelf())
	END

