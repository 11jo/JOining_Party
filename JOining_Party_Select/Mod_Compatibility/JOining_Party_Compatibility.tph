/*
LAM JOINABLE_NPC_ARRAYS // Use DEFINE_ACTION_MACRO from JOining_Party_Joined.tph

ACTION_PHP_EACH JOINABLE_NPC_ARRAY AS cre => dv BEGIN
// 	PRINT ~%cre% => %dv%~

// No tutorial characters
	ACTION_IF NOT (~%cre%~ STRING_EQUAL_CASE ~TTBRAN.CRE~)
			AND NOT (~%cre%~ STRING_EQUAL_CASE ~TTIMOEN.CRE~)
			AND NOT (~%cre%~ STRING_EQUAL_CASE ~TTJAHIER.CRE~)
			AND NOT (~%cre%~ STRING_EQUAL_CASE ~TTMINSC.CRE~)
			AND NOT (~%cre%~ STRING_EQUAL_CASE ~TTXAN.CRE~) THEN BEGIN

		COPY_EXISTING ~%cre%~ ~override~
			READ_ASCII 0x248 override_script_comp
			READ_ASCII 0x288 Default_script_comp
			READ_ASCII 0x260 general_script_comp
			READ_ASCII 0x2cc dialog_comp
			READ_ASCII 0x280 DeathVar_comp
			READ_BYTE 0x234 level_comp

// No every associated to DeathVar joignable characters
				PATCH_IF NOT (~%override_script_comp%~ STRING_EQUAL_CASE ~idiot01~)
					AND NOT (~%override_script_comp%~ STRING_EQUAL_CASE ~NONE~)
					AND NOT (~%override_script_comp%~ STRING_EQUAL_CASE ~SHOUT~)
					AND NOT (~%override_script_comp%~ STRING_EQUAL_CASE ~INITDLG~)
					AND NOT (~%dialog_comp%~ STRING_EQUAL_CASE ~~)
					AND NOT (~%dialog_comp%~ STRING_EQUAL_CASE ~NONE~)
					AND (~%Default_script_comp%~ STRING_EQUAL_CASE ~~ OR ~%general_script_comp%~ STRING_EQUAL_CASE ~~)

// No original already global characters
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Imoen2~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Imoen~)

						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Edwin~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Jaheira~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Minsc~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Viconia~)

						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Ajantis~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Alora~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Branwen~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Coran~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Dynaheir~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Eldoth~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Faldorn~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Garrick~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Kagain~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Khalid~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Kivan~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Montaron~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Quayle~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Safana~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Sharteel~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Skie~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Tiax~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Xan~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Xzar~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Yeslick~)

						AND NOT (~%cre%~ STRING_EQUAL_CASE ~BAELOTH7.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~A.CRE~)

						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Osprey~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Deeder~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Deder~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Arkanis~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Mordaine~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Canderous~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Obe~)

						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~BDCAELAR~)

						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Aerie~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Anomen~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Cernd~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Haerdalis~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Jan~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Keldorn~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Korgan~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Mazzy~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Nalia~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Sarevok~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Valygar~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Wilson~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~Yoshimo~)

						AND NOT (~%cre%~ STRING_EQUAL_CASE ~DORN2.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~DORN4.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~DORN6.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~DORN7.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~DORN9.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~DORN10.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~DORN12.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~DORN14.CRE~)

						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA2.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA4.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA6.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA7.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA10.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA11.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA12.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA13.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~NEERA15.CRE~)

						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD2.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD4.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD6.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD7.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD9.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD10.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD11.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD12.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~RASAAD13.CRE~)

						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHEX9.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHEX10.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHEX11.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHEX13.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHEX15.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHEX25.CRE~)

						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHFAK9.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHFAK10.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHFAK11.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHFAK13.CRE~)
						AND NOT (~%cre%~ STRING_EQUAL_CASE ~OHHFAK15.CRE~)
// Mod
						AND (~%cre%~ STRING_CONTAINS_REGEXP ~X32\.*.CRE~)
						AND (~%cre%~ STRING_CONTAINS_REGEXP ~\.*25.CRE~)
						AND NOT (~%DeathVar_comp%~ STRING_EQUAL_CASE ~%only_one_comp%~)
//	only_one_comp
					BEGIN

							PATCH_IF (~%Default_script_comp%~ STRING_EQUAL_CASE ~~) BEGIN
								WRITE_ASCII SCRIPT_DEFAULT ~JOINSETD~ (8)

							END ELSE PATCH_IF (~%general_script_comp%~ STRING_EQUAL_CASE ~~) BEGIN
										WRITE_ASCII SCRIPT_GENERAL ~JOINSETG~ (8)
								PATCH_PRINT ~%cre% %dv% : added...
													~
							END // PATCH_IF (~%Default_script_comp%~ STRING_EQUAL_CASE ~~)

					INNER_ACTION BEGIN
		COPY ~weidu_external/JOining_Party_Select/Mod_Compatibility/START.baf~  ~weidu_external/JOining_Party_Select/Mod_Compatibility/START.baf~ EVALUATE_BUFFER
				REPLACE_TEXTUALLY ~//	REPLACE_STARTING_BLOCK~ ~		CreateCreatureImpassable("%cre%",[-1.-1],0)
\0~
						PATCH_PRINT ~%cre%  %dv% : added to %SOURCE_FILE%...
													~

		COPY ~weidu_external/JOining_Party_Select/Mod_Compatibility/START.baf~  ~weidu_external/JOining_Party_Select/Mod_Compatibility/START.baf~ EVALUATE_BUFFER
				REPLACE_TEXTUALLY ~\.cre~ ~~

						ACTION_IF FILE_EXISTS_IN_GAME ~%override_script_comp%.bcs~ BEGIN

									EXTEND_TOP ~%override_script_comp%.bcs~ ~JOining_Party_Select/Mod_Compatibility/MakeGlobalOverride.baf~ EVALUATE_BUFFER

// Only one cre
		OUTER_SPRINT "only_one_comp" "%DeathVar_comp%"

// INCLUDE ~JOining_Party_Select/Mod_Compatibility/JOining_Party_Only_One.tph~

						END // ACTION_IF FILE_EXISTS_IN_GAME

					END // INNER_ACTION

				END // PATCH_IF NOT (~%override_script_comp%~ STRING_EQUAL_CASE ~idiot01~)

	END // ACTION_IF NOT (~%cre%~ STRING_EQUAL_CASE ~TTBRAN.CRE~)


END // ACTION_PHP_EACH JOINABLE_NPC_ARRAY
*/


